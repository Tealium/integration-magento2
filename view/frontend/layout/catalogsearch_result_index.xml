<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <referenceBlock name="tealium_generic" remove="true"/>
            <block class="Tealium\Tags\Block\Template" name="tealium_catalogsearch_result_index" ifconfig="tealium_tags/general/enable" as="tealium_catalogsearch_result_index" template="tealium_tags/catalogsearch_result_index.phtml" before="tealium_base" />
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Tealium\Tags\Block\Template" name="tealium_product_on_page" ifconfig="tealium_tags/general/enable" template="Tealium_Tags::tealium_tags/product_on_page.phtml">
                <arguments>
                    <argument name="list_block" xsi:type="string">search_result_list</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
